RESUME_IPV4=192.0.2.10
RESUME_NETWORK=example_lan
RESUME_URL=https://resume.example.com/

# Wallet display text (the generated artifacts are ignored by Git).
PASS_LABEL=Resume

# Apple Wallet: PEM files created from an Apple Pass Type ID certificate.
APPLE_PASS_TYPE_ID=pass.com.example.resume
APPLE_TEAM_ID=ABCDE12345
APPLE_PASS_CERT=credentials/apple-pass-cert.pem
APPLE_PASS_KEY=credentials/apple-pass-key.pem
APPLE_WWDR_CERT=credentials/apple-wwdr.pem

# Google Wallet: issuer onboarding and a service-account JSON key are required.
GOOGLE_ISSUER_ID=1234567890123456789
GOOGLE_SERVICE_ACCOUNT_JSON=credentials/google-wallet.json
